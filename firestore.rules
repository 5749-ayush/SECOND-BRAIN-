rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isMember(workspaceId) {
      return request.auth != null
        && workspaceId == "main"
        && exists(memberPath(workspaceId))
        && get(memberPath(workspaceId)).data.status == "active";
    }

    function isOwner(workspaceId) {
      return isMember(workspaceId)
        && get(memberPath(workspaceId)).data.role == "owner";
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if isOwner(workspaceId);
      }

      match /memberInvites/{email} {
        allow read, create, update, delete: if isOwner(workspaceId);
      }

      match /agentKeys/{keyId} {
        allow read, create, update, delete: if isOwner(workspaceId);
      }

      match /ideas/{ideaId} {
        allow read, create, update, delete: if isMember(workspaceId);
      }

      match /categories/{categoryId} {
        allow read, create, update, delete: if isMember(workspaceId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
